# This file is used to set up environment variables for the application.
# Copy this file to .env and fill in the required values.

# DJANGO CONFIG
## Debug mode can be 't' or ''
DJANGO_DEBUG='t'
## Secret key for Django
DJANGO_SECRET_KEY=''
## Allowed hosts for Django. The value should be a comma-separated list of hostnames or IP addresses.
DJANGO_ALLOWED_HOSTS='localhost'
## Trusted origins for CSRF. The value should be a comma-separated list of URLs.
DJANGO_CSRF_TRUSTED_ORIGINS='http://localhost:81'


# Media host
MEDIA_HOST='http://localhost:8000'


# Telegram bot token
TELEGRAM_BOT_TOKEN=


# Configuration for showing the browser when running the invoice downloading
# 't' to show the browser, 'f' to hide it
SHOW_BROWSER=''


# DATABASE CONFIG (PostgreSQL)
# Dejar en blanco para usar SQLite en desarrollo local
DB_NAME='donacion_medicamentos'
DB_USER='donacion_user'
DB_PASSWORD='donacion_pass'
DB_HOST='postgres'
DB_PORT='5432'
# Requerido en producción contra un Postgres gestionado (ej. Neon): 'require'.
# Vacío o 'disable' para el Postgres local de docker-compose.
DB_SSLMODE=''


# ALMACENAMIENTO DE MEDIA (opcional)
# Si se dejan vacías, los archivos de MEDIA se guardan en disco local (./media).
# Si se llenan, se usa un bucket S3-compatible (ej. Cloudflare R2) en su lugar.
AWS_STORAGE_BUCKET_NAME=''
AWS_ACCESS_KEY_ID=''
AWS_SECRET_ACCESS_KEY=''
AWS_S3_ENDPOINT_URL=''
AWS_S3_REGION_NAME='auto'


# Docker configuration
IMAGE='donacion_medicamentos-backend:1.0.1'